# The buzzer sits on the central (or a non-split keyboard) and behaviors run
# there too, so nothing is enabled for peripherals.

config ZMK_BUZZER
    bool
    default y
    depends on DT_HAS_ZMK_BUZZER_ENABLED
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    select PWM

config ZMK_BUZZER_INIT_PRIORITY
    int "Buzzer init priority"
    default 60
    depends on ZMK_BUZZER
    help
      Must come after the PWM driver (PWM_INIT_PRIORITY).

config ZMK_BEHAVIOR_BUZZER
    bool
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_BUZZER_ENABLED
    depends on ZMK_BUZZER

config ZMK_BEHAVIOR_BUZZER_INIT_PRIORITY
    int "Buzzer behavior init priority"
    default 70
    depends on ZMK_BEHAVIOR_BUZZER
    help
      Must come after the buzzer (ZMK_BUZZER_INIT_PRIORITY).

config ZMK_BUZZER_TRIGGERS
    bool
    default y
    depends on DT_HAS_ZMK_BUZZER_TRIGGERS_ENABLED
    depends on ZMK_BUZZER

config ZMK_BUZZER_TEST_PWM
    bool
    default y
    depends on DT_HAS_ZMK_BUZZER_TEST_PWM_ENABLED
    depends on PWM
    help
      Logging PWM controller used by the native_sim tests.
